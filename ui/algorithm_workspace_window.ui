  <property name="styleSheet">
   <string notr="true">QFrame#AlgorithmWorkspaceWindow {
    border: 2px solid #6f8f98;
    border-radius: 7px;
}
QFrame#AlgorithmWorkspaceWindow[replayConfigured=&quot;true&quot;] {
    border-color: #4aa3d8;
}
QLabel#lblName[replayConfigured=&quot;true&quot;] {
    color: #8ad7ff;
}
QFrame#AlgorithmWorkspaceWindow[activeWorkspace=&quot;true&quot;] {
    border: 3px solid #f2c14e;
}
QLabel#lblName[activeWorkspace=&quot;true&quot;] {
    background-color: rgba(242, 193, 78, 78);
    border-left: 6px solid #f2c14e;
    border-radius: 4px;
    color: #fff4c2;
    padding: 0px 6px;
}
QPushButton#btnReplaySettings[replayConfigured=&quot;true&quot;] {
    border: 1px solid #4aa3d8;
    color: #d8f3ff;
    font-weight: 700;
}
QFrame#AlgorithmWorkspaceWindow[runtimeState=&quot;RUNNING&quot;] {
    border-color: #35b96f;
}
QFrame#AlgorithmWorkspaceWindow[runtimeState=&quot;STARTING&quot;],
QFrame#AlgorithmWorkspaceWindow[runtimeState=&quot;STOPPING&quot;] {
    border-color: #f2c14e;
}
QFrame#AlgorithmWorkspaceWindow[runtimeState=&quot;ERROR&quot;] {
    border-color: #ef5350;
}
QPushButton#btnStartStop[actionMode=&quot;START&quot;] {
    background-color: #237a4b;
    border: 1px solid #35b96f;
    color: #ffffff;
    font-weight: 700;
    min-height: 0px;
    max-height: 24px;
    padding: 0px 10px;
}
QPushButton#btnStartStop[actionMode=&quot;STOP&quot;] {
    background-color: #8f2d2d;
    border: 1px solid #ef5350;
    color: #ffffff;
    font-weight: 700;
    min-height: 0px;
    max-height: 24px;
    padding: 0px 10px;
}
QLabel#lblState {
    border: 1px solid #54747d;
    border-radius: 5px;
    min-height: 0px;
    max-height: 24px;
    padding: 0px 8px;
    font-weight: 700;
}
QPushButton#btnHistoryDownload,
QPushButton#btnReplaySettings,
QPushButton#btnParameters,
QPushButton#btnRename {
    min-height: 0px;
    max-height: 22px;
    padding: 0px 8px;
    font: 9pt &quot;Segoe UI&quot;;
}
QPushButton#btnReplayPause,
QPushButton#btnReplayStep {
    min-height: 0px;
    max-height: 18px;
    padding: 0px 6px;
    font: 8pt &quot;Segoe UI&quot;;
}
QComboBox#cmbReplaySpeed {
    min-height: 0px;
    max-height: 18px;
    padding: 0px 4px;
    font: 8pt &quot;Segoe UI&quot;;
}
QLabel#lblReplayStatus,
QLabel#lblReplaySpeed {
    font: 8pt &quot;Segoe UI&quot;;
}
QFrame#frameSummary {
    border: 1px solid #315965;
    border-radius: 5px;
}
QLabel[summaryValue=&quot;true&quot;] {
    font-weight: 700;
}
QTabWidget#tabsWorkspace::pane {
    border: 1px solid #315965;
}
QTabBar::tab {
    padding: 4px 10px;
}</string>
